# Photo View Tracker Configuration
# Copy this file to ".env" in the repository root and customize values for your setup.
# Process environment variables override values defined in ".env".

# ------------------------------------------------------------------------------
# Storage & Media Paths
# ------------------------------------------------------------------------------
# Root directory of your photo/video library (always accessed 100% read-only).
# Sample fixture photos are available in ./examples/photos (or run: make seed-examples).
LIBRARY_PATH=./photos

# SQLite database file path (must be outside LIBRARY_PATH).
DB_PATH=./data/photos.db

# Generated 400px thumbnails and 2560px preview cache directory (outside LIBRARY_PATH).
CACHE_PATH=./data/cache

# ------------------------------------------------------------------------------
# HTTP Server
# ------------------------------------------------------------------------------
# Interface address to bind (leave empty to bind all interfaces; 127.0.0.1 recommended locally).
HOST=127.0.0.1

# TCP port for the HTTP server (1..65535).
PORT=8080

# ------------------------------------------------------------------------------
# Authentication & Cookies
# ------------------------------------------------------------------------------
# Set to true to bypass login for frictionless local-only usage.
AUTH_DISABLED=false

# Plaintext password for single-user login when AUTH_DISABLED=false.
AUTH_PASSWORD=change-me

# Optional SHA-256 hex digest alternative to AUTH_PASSWORD (takes precedence if set).
# AUTH_PASSWORD_HASH=

# Optional HMAC-SHA256 signing secret for session cookies.
# If omitted, a random secret is generated on first run and persisted in SQLite app_settings.
# AUTH_SECRET=

# Set to true when serving behind HTTPS so session cookies include the Secure flag.
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Workers & Logging
# ------------------------------------------------------------------------------
# Max parallel SHA-256 hashing workers during library sync (defaults to runtime.NumCPU()).
# SYNC_WORKERS=8

# Max parallel external media decoding workers (defaults to min(4, max(1, NumCPU/2))).
# PREVIEW_WORKERS=4

# Structured log format: text | json
LOG_FORMAT=text

# Minimum structured log severity: debug | info | warn | error
LOG_LEVEL=info
